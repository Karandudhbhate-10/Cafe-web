# Server Port
PORT=5001

# MongoDB Connection String (Local MongoDB or MongoDB Atlas URI)
# Example Local: mongodb://127.0.0.1:27017/brewandbean
# Example Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/brewandbean?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/brewandbean

# JWT Secret for Staff/Admin authentication
JWT_SECRET=brew_and_bean_super_secret_jwt_key_2026

# Frontend Client URL (for CORS and development proxy)
CLIENT_URL=http://localhost:5173

# Default Base URL encoded into table QR codes
# IMPORTANT FOR PRODUCTION: Set this to your deployed domain, e.g. https://brewandbean.cafe
QR_BASE_URL=http://localhost:5173

# Initial seed admin password (optional, defaults to admin123)
ADMIN_PASSWORD=admin123

# ====================================================================
# UPI & Payment Gateway Configuration
# ====================================================================
# Direct UPI Payee Details (Used for Google Pay, PhonePe, Paytm, and QR Codes)
CAFE_UPI_ID=karandudhbhate2@oksbi
CAFE_PAYEE_NAME="BREW AND BEAN CAFE"

# Razorpay Online Payment Gateway (Optional / Sandbox test credentials)
# Get from Razorpay Dashboard -> Settings -> API Keys (Test Mode)
RAZORPAY_KEY_ID=rzp_test_YourKeyIdHere
RAZORPAY_KEY_SECRET=YourKeySecretHere

# Razorpay Webhook Secret (Set up in Razorpay Dashboard -> Webhooks)
RAZORPAY_WEBHOOK_SECRET=YourWebhookSecretHere

